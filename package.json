{
  "name": "forj-review-audit",
  "private": true,
  "scripts": {
    "dev:extension": "npm --prefix apps/review-extension run dev",
    "build:extension": "npm --prefix apps/review-extension run build",
    "build:extension:public": "npm --prefix apps/review-extension run build:public",
    "test:extension": "npm --prefix apps/review-extension test",
    "lint:extension": "npm --prefix apps/review-extension run lint",
    "check:architecture": "python scripts/ci/check_architecture.py && node scripts/ci/check-extension-architecture.mjs",
    "test:extension:browser": "npm --prefix apps/review-extension run test:browser",
    "format": "npm --prefix apps/review-extension run format",
    "format:check": "npm --prefix apps/review-extension run format:check"
  }
}
