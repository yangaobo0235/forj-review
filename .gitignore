# Environment and secrets
.env
.env.*
# 取反必须覆盖「所有」示例文件。只写 `!.env.example` 只放行这一个精确文件名，
# `.env.production.example` 这类会被 `.env.*` 吞掉——而且被忽略的文件不会出现在
# `git status` 里，等于静默消失在仓库之外。
!*.example
/deploy/review-agent.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
.uv-cache/

# Node.js
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
coverage/
*.log
# 按天轮转出的历史分片（review-agent.log.2026-09-23 这类），`*.log` 匹配不到。
*.log.[0-9]*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local agent state and temporary work
.tmp/
# 本地按天轮转的后端日志（REVIEW_LOG_DIR=logs，落在 review-agent-service/logs）
logs/
# 根目录下的平铺临时文件（如 .tmp-real-assist.json）。上面的 `.tmp/` 只匹配目录，
# 匹配不到这类文件；它们曾把真实的审核响应带进过 git 历史。
.tmp-*
.worktrees/
.superpowers/
