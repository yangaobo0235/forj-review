# 复制为本目录的 .env，填写聊天配置 Agent 自己的模型密钥。
# 不读取根目录或审核后端的 .env，也不回退使用 DASHSCOPE_API_KEY。
# 进程环境变量优先；本文件的目录项相对于本文件所在目录解析。
CONFIGURATION_API_KEY=
CONFIGURATION_MODEL_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
CONFIGURATION_MODEL=qwen3.8-flash
CONFIGURATION_MAX_CALLS=24

# 本地日志及人工登记的验收集；会话和 checkpoint 保存在 PostgreSQL。
CONFIGURATION_STATE_DIR=../../.review-config
CONFIGURATION_CASES_DIR=../../examples/page-config
CONFIGURATION_REVIEW_URL=http://127.0.0.1:26101

# 默认读取根目录 .env.database 的标准 PG* 变量，目标为 forj_review.public。
# 这里的 URL 可覆盖共享配置。配置服务仍只在本机运行。
CONFIGURATION_DATABASE_URL=
CONFIGURATION_DATABASE_SCHEMA=local
