# 复制为本目录的 .env，填写审核服务自己的模型密钥。不要把密钥交给前端。
# 只加载 src/forj_review_service/.env，不读取仓库根目录或配置后端的 .env。
# 进程环境变量优先；本文件的目录项相对于本文件所在目录解析。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash

# 默认读取根目录 .env.database 的标准 PG* 变量，目标为 forj_review.public。
# 这里的 URL 可覆盖共享数据库配置；未配置数据库时启动失败。
REVIEW_DATABASE_URL=
REVIEW_DATABASE_SCHEMA=local

REVIEW_MODEL_GLOBAL_CONCURRENCY=16
REVIEW_MODEL_JOB_CONCURRENCY=8
REVIEW_FINALIZE_CONCURRENCY=2

# 二维码原图下载默认只允许公网 IP。仅当原图确实托管于内网时，填写精确主机名或 IP，逗号分隔。
# 每次跳转都会重新校验；不支持通配符，不要填写完整 URL。
REVIEW_IMAGE_PRIVATE_HOSTS=

# 日志在仓库 logs/ 下，按天或大小轮转，最多保留 30 份归档。
REVIEW_LOG_DIR=../../logs
REVIEW_LOG_LEVEL=INFO
REVIEW_LOG_MAX_MB=10
REVIEW_LOG_BACKUP_COUNT=30
REVIEW_LOG_REQUIRED=false

# 车型业务服务网关前缀（不要包含具体接口路径）；为空时明确显示接口未配置。
REVIEW_VEHICLE_API_BASE_URL=
REVIEW_VEHICLE_API_TIMEOUT=15
# 暂不要求鉴权；后续使用服务 Bearer Token 时由后端配置，勿写入扩展。
REVIEW_VEHICLE_API_TOKEN=
