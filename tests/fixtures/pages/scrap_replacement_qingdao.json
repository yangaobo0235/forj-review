    {
      "document_type": "registration_certificate",
      "label": "机动车登记证书",
      "hints": [
        "登记证书",
        "机动车登记证",
        "旧车资料",
        "新车资料"
      ],
      "guidance": "读取机动车所有人、车辆识别代号、车辆类型、燃料种类和注册登记机动车信息栏第12项‘发动机型号’。不要把发动机号码、车辆型号或其他编号当成发动机型号。同时读取图片内明确印刷的页脚页码，registration.covered_pages 只输出图片中实际可见的页码数字数组，例如页脚同时出现‘第1页’和‘第2页’时输出 [1,2]；不要按上传顺序推测。",
      "scopes": [],
      "required": false,
      "minimum_count": 1,
