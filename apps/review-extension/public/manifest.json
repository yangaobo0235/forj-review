{
  "manifest_version": 3,
  "name": "赋界审核辅助工作台",
  "version": "0.1.0",
  "description": "读取车辆审核页面并提供一致性审核建议",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:26101/*",
    "http://localhost:26101/*",
    "http://127.0.0.1:26102/*",
    "http://localhost:26102/*",
    "http://175.178.6.214:26101/*",
    "http://test.forjtruck.com/*",
    "https://test.forjtruck.com/*",
    "https://admin.forjtruck.com/*",
    "http://192.168.2.23:26101/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "action": {
    "default_title": "打开赋界审核辅助工作台",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
