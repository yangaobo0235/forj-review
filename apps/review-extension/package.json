{
  "name": "@forj/review-extension",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1 --port 26199 --strictPort",
    "build": "vue-tsc -b && vite build --mode development",
    "build:public": "vue-tsc -b && vite build --mode public",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1 --port 26199 --strictPort",
    "test:watch": "vitest",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@forj/configuration-contracts": "file:../../packages/configuration-contracts",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.2.6",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.7.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.0"
  }
