# Copy this file to .env and replace the API key locally.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash

# 本地和生产共用默认值；生产脚本通过 --env-file 读取 /opt/review-assistant/.env。
# 修改服务端 .env 后重新执行 start-review.sh，Compose 会使用这些并发覆盖值。
REVIEW_MODEL_GLOBAL_CONCURRENCY=16
REVIEW_MODEL_JOB_CONCURRENCY=8
REVIEW_FINALIZE_CONCURRENCY=2

# 日志按天或大小轮转（先满足者触发），最多保留 30 份归档，并非保证 30 天。
# 相对路径按启动时的工作目录解析：
# scripts/dev/start-agent.ps1 从仓库根目录启动，所以落在
# logs/（已在 .gitignore 里，不会进仓库）。
# 注释掉这一行 = 只输出控制台，与历史行为一致。
REVIEW_LOG_DIR=logs
REVIEW_LOG_LEVEL=INFO
REVIEW_LOG_MAX_MB=10
REVIEW_LOG_BACKUP_COUNT=30
# 本地文件不可写时可降级控制台；生产 Compose 固定为 true，不允许无持久日志启动。
REVIEW_LOG_REQUIRED=false

# 可选：启用已校验的声明式页面配置；修改后重启服务。
# REVIEW_PAGES_DIR=review-pages
