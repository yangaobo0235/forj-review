# Copy to .env on the server. Fill in the review service model API key.
# Do not upload local secrets or commit this file after filling in credentials.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash
REVIEW_MODEL_GLOBAL_CONCURRENCY=16
REVIEW_MODEL_JOB_CONCURRENCY=8
REVIEW_FINALIZE_CONCURRENCY=2
REVIEW_IMAGE_PRIVATE_HOSTS=

# Business vehicle gateway prefix, including /api/admin; leave blank until available.
REVIEW_VEHICLE_API_BASE_URL=
REVIEW_VEHICLE_API_TIMEOUT=15
# Optional backend service Bearer token; authentication may be configured later.
REVIEW_VEHICLE_API_TOKEN=
