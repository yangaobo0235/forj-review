# Copy to .env.database in the server application directory.
# The application and the existing PostgreSQL container share postgres_network.
PGHOST=postgres
PGPORT=5432
PGDATABASE=forj_review
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=disable
DATABASE_POOL_SIZE=6
DATABASE_POOL_TIMEOUT=5
DATABASE_POOL_RECYCLE=1800
