# Shared by both local backends. PostgreSQL/libpq standard connection variables.
# For a direct connection, set PGHOST to your database server address.
# Use 127.0.0.1 only if PostgreSQL is reachable through a local listener.
# Fill PGPASSWORD with the existing postgres account password; do not commit this file.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=forj_review
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=disable
